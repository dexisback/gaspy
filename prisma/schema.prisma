generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())
  chunks    Chunk[]
}

model Chunk {
  id         String                 @id @default(cuid())
  content    String
  embedding  Unsupported("vector(3072)")?
  documentId String
  createdAt  DateTime               @default(now())
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model QAPair {
  id        String   @id @default(cuid())
  question  String
  answer    String
  questionEmbedding Unsupported("vector(3072)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionLog {
  id         String   @id @default(cuid())
  question   String
  hasContext Boolean
  createdAt  DateTime @default(now())
}


model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}